# WS 시스템 환경변수 — 형님 로컬에서 .env로 복사 후 값 채우세요

# Sentry (선택) — 활성화하려면 DSN 입력하고 main.jsx에서 import
# https://sentry.io/settings/projects/<project>/keys/ 에서 발급
VITE_SENTRY_DSN=

# AI 백엔드 (Phase 4.1 구현 후) — Cloud Run으로 띄운 STT/Gemini 프록시 URL
VITE_AI_BACKEND_URL=https://api-XXXXX.run.app

# 초기 admin 이메일 (firebase.js의 INITIAL_ADMIN_EMAIL과 일치해야 함)
VITE_INITIAL_ADMIN_EMAIL=ttong627@gmail.com
